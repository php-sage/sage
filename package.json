{
  "private": true,
  "devDependencies": {
    "sass": "*",
    "uglify-js": "*"
  },
  "watch": {
    "compile-js": "src/resources/js/scripts.js",
    "compile-themes": "src/resources/css/themes/*.scss",
    "compile-plain-html-css": "src/resources/plain-html.scss"
  },
  "scripts": {
    "compile-themes": "sass --style=compressed --no-source-map src/resources/css/themes/:src/resources/compiled/",
    "compile-plain-html-css": "sass --style=compressed --no-source-map src/resources/css/plain-html.scss:src/resources/compiled/plain-html.css",
    "compile-js": "uglifyjs src/resources/js/scripts.js -cm --toplevel --mangle-props -o src/resources/compiled/sage.js",
    "watch": "npm-watch",
    "build": "npm run compile-js; npm run compile-themes; npm run compile-plain-html-css;"
  }
}
